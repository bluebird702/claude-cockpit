  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.cockpit-hooks/guard-secrets.sh || {{COCKPIT_HOME}}/system/hooks/guard-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{COCKPIT_HOME}}/system/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{COCKPIT_HOME}}/system/hooks/format.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{COCKPIT_HOME}}/system/hooks/guard-prompt-injection.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{COCKPIT_HOME}}/system/hooks/session-context.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{COCKPIT_HOME}}/system/hooks/session-end.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $(0) }'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); r=$(command -v bun 2>/dev/null || command -v node 2>/dev/null); case \"$(basename \"$r\" 2>/dev/null)\" in bun) exec \"$r\" --env-file /dev/null \"${plugin_dir}dist/index.js\";; *) exec \"$r\" \"${plugin_dir}dist/index.js\";; esac'"
  },
  "enabledPlugins": {
    "backend-development@claude-code-workflows": true,
    "database-design@claude-code-workflows": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "claude-hud@claude-hud": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "voiceEnabled": false,
  "_comment": "claude-cockpit 전역 설정. 원본은 system/settings.json.template — 설치 시 .cockpit-local/settings.json 으로 렌더되어 ~/.claude/settings.json 에 링크됩니다. 갱신은 scripts/update.sh, 개인 오버라이드는 ~/.claude/settings.local.json (이 파일을 직접 수정하지 말 것)."
}
