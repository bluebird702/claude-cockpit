# cockpit MCP 환경변수 예시
# setup.sh --env-file <path> 로 일괄 주입할 수 있습니다.
# 실제 값은 ~/.config/claude-cockpit/mcp.env 에 저장되며 cockpit 레포에는 커밋하지 마세요.

GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

JIRA_URL=https://your.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

CONFLUENCE_URL=https://your.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Slack: 공식 원격 MCP (https://mcp.slack.com/mcp) 사용 — 토큰 불필요, OAuth 브라우저 인증

FIGMA_API_KEY=figd_xxxxxxxxxxxxxxxxxxxxxxxx
